# Hanya file server; jangan menyalin secret ke web/ atau public/.
HOST=127.0.0.1
PORT=3080
APP_ORIGIN=http://127.0.0.1:3080
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_GOOGLE_ENABLED=false
# Akun disetujui lewat app_metadata yang dikelola admin Supabase:
# sidaksa_approved=true; sidaksa_role=admin|recruiter|leader
GOOGLE_SPREADSHEET_ID=1TrkKzadHZyMmc0ZfMe8CUic66s5-96XZ4vdBpsEuEes
GOOGLE_USE_ADC=false
# Isi lokasi file service account yang aman, bukan isi private key.
GOOGLE_APPLICATION_CREDENTIALS=
# Dua tab rekap tidak dibaca otomatis; aktifkan hanya setelah disetujui.
GOOGLE_REFERENCE_TABS=[]
SYNC_INTERVAL_MINUTES=15
SNAPSHOT_RETENTION_DAYS=30
SIDAKSA_DATA_DIR=.private/data
