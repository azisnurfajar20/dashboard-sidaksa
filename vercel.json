{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/sidaksa-data.ts": { "maxDuration": 60 },
    "api/sidaksa-cron.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/sidaksa-cron", "schedule": "0 0 * * *" }],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/sidaksa-data?__sidaksa_route=0" },
    { "source": "/api/status", "destination": "/api/sidaksa-data?__sidaksa_route=1" },
    { "source": "/api/dictionaries", "destination": "/api/sidaksa-data?__sidaksa_route=2" },
    { "source": "/api/overview", "destination": "/api/sidaksa-data?__sidaksa_route=3" },
    { "source": "/api/applications", "destination": "/api/sidaksa-data?__sidaksa_route=4" },
    { "source": "/api/applications/:__sidaksa_id", "destination": "/api/sidaksa-data?__sidaksa_route=5" },
    { "source": "/api/candidates", "destination": "/api/sidaksa-data?__sidaksa_route=6" },
    { "source": "/api/candidates/:__sidaksa_id", "destination": "/api/sidaksa-data?__sidaksa_route=7" },
    { "source": "/api/partners", "destination": "/api/sidaksa-data?__sidaksa_route=8" },
    { "source": "/api/departures", "destination": "/api/sidaksa-data?__sidaksa_route=9" },
    { "source": "/api/issues", "destination": "/api/sidaksa-data?__sidaksa_route=10" },
    { "source": "/api/issues/:__sidaksa_id/review", "destination": "/api/sidaksa-data?__sidaksa_route=11" },
    { "source": "/api/settings", "destination": "/api/sidaksa-data?__sidaksa_route=12" },
    { "source": "/api/sync", "destination": "/api/sidaksa-data?__sidaksa_route=13" },
    { "source": "/api/mappings", "destination": "/api/sidaksa-data?__sidaksa_route=14" },
    { "source": "/api/audit", "destination": "/api/sidaksa-data?__sidaksa_route=15" },
    { "source": "/api/export", "destination": "/api/sidaksa-data?__sidaksa_route=16" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(rekrutmen|kandidat|mitra|keberangkatan|kualitas-data|pengaturan|password)", "destination": "/index.html" }
  ]
}
